# Copy this file to .env and fill in values, do NOT commit .env to version control

# LLM provider: 'openai' or 'deepseekapi'
LLM_PROVIDER=deepseekapi


LLM_MODEL=deepseek-v4-flash


# If using DeepseekAPI
DEEPSEEKAPI_URL=https://api.deepseek.com/chat/completions
DEEPSEEKAPI_KEY=sk-74c7181350ed4a70b2f53616de16dbf9
DEEPSEEKAPI_PROMPT_FIELD=prompt
DEEPSEEKAPI_RESPONSE_FIELD=text

# Optional runtime flags
SPIDER_DEBUG=true

# Alerting configuration examples
# Enable alerts by setting ALERT_ENABLED=true
# For webhook alerts:
# ALERT_PROVIDER=webhook
# ALERT_WEBHOOK_URL=https://your-webhook-endpoint
# ALERT_WEBHOOK_TIMEOUT_SECONDS=10
# For SMTP email alerts:
# ALERT_PROVIDER=smtp
# ALERT_SMTP_HOST=smtp.example.com
# ALERT_SMTP_PORT=587
# ALERT_SMTP_USERNAME=your-user
# ALERT_SMTP_PASSWORD=your-password
# ALERT_SENDER=spider-alert@example.com
# ALERT_RECEIVERS=ops@example.com,admin@example.com
