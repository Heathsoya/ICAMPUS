# Copy this file to .env and fill in values, do NOT commit .env to version control

# LLM provider: 'openai' or 'deepseekapi'
LLM_PROVIDER=deepseekapi

# If using OpenAI
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
LLM_API_URL=

# If using DeepseekAPI
DEEPSEEKAPI_URL=https://api.deepseek.com/chat/completions
DEEPSEEKAPI_KEY=sk-74c7181350ed4a70b2f53616de16dbf9
DEEPSEEKAPI_PROMPT_FIELD=prompt
DEEPSEEKAPI_RESPONSE_FIELD=text

# Optional runtime flags
SPIDER_DEBUG=true
