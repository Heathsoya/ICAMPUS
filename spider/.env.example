## 环境变量示例
# LLM 配置
# LLM_PROVIDER：LLM 提供商，支持 openai 或 deepseekapi
LLM_PROVIDER=openai
# LLM_API_KEY：OpenAI API Key，用于调用 OpenAI 模型
LLM_API_KEY=

# DeepseekAPI（可选）
# DEEPSEEKAPI_URL：Deepseek API 接口地址
DEEPSEEKAPI_URL=
# DEEPSEEKAPI_KEY：Deepseek API Key，用于授权调用
DEEPSEEKAPI_KEY=

# 报警配置（可选）
# ALERT_ENABLED：是否启用报警，true/false
ALERT_ENABLED=false
# ALERT_PROVIDER：报警方式，支持 webhook 或 smtp
ALERT_PROVIDER=webhook
# ALERT_WEBHOOK_URL：报警 webhook URL 地址
ALERT_WEBHOOK_URL=
# ALERT_SMTP_HOST：SMTP 邮件服务器主机
ALERT_SMTP_HOST=
# ALERT_SMTP_PORT：SMTP 邮件服务器端口
ALERT_SMTP_PORT=587
# ALERT_SMTP_USERNAME：SMTP 登录用户名
ALERT_SMTP_USERNAME=
# ALERT_SMTP_PASSWORD：SMTP 登录密码
ALERT_SMTP_PASSWORD=
# ALERT_SENDER：报警邮件发送者地址
ALERT_SENDER=
# ALERT_RECEIVERS：报警邮件接收者，多个以逗号分隔
ALERT_RECEIVERS=

# 调度配置
# SCHEDULE_INTERVAL_DAYS：定时任务间隔天数，默认 7 天检查一次
SCHEDULE_INTERVAL_DAYS=7
# SCHEDULE_INTERVAL_MINUTES：兼容旧配置的分钟间隔，若未设置 DAYS 则使用
SCHEDULE_INTERVAL_MINUTES=60
# SCHEDULE_RUN_ON_START：启动时是否立即执行一次，true/false
SCHEDULE_RUN_ON_START=true

# 其他
# SPIDER_DEBUG：是否开启调试模式，true/false
SPIDER_DEBUG=false
